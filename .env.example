# Public URL used by Auth.js and metadata.
AUTH_URL=http://localhost:3000

# Root domain used for generated league subdomains.
ATHEUS_ROOT_DOMAIN=atheus.dev

# Generate with: npx auth secret
AUTH_SECRET=replace-with-a-generated-secret
# NEXTAUTH_SECRET is accepted as a backwards-compatible alias.

# Discord Developer Portal OAuth application.
AUTH_DISCORD_ID=replace-with-discord-client-id
AUTH_DISCORD_SECRET=replace-with-discord-client-secret

# Operational bot identity. This may be a different Discord application from
# the website OAuth application, which makes a future bot replacement safe.
ATHEUS_BOT_CLIENT_ID=replace-with-atheus-bot-client-id
ATHEUS_DISCORD_BOT_TOKEN=replace-with-atheus-bot-token
ATHEUS_BOT_PERMISSIONS=268561424

# Shared Supabase project used by the Atheus website and League Bot.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Used to HMAC privacy-reduced anti-abuse signals. Generate a separate random
# value in production; AUTH_SECRET is used only as a fallback.
ABUSE_SIGNAL_SECRET=replace-with-a-generated-secret

# Optional free-tier community-size gate. Zero disables this check.
ATHEUS_FREE_MIN_GUILD_MEMBERS=0

# Optional EA access overrides. Leave blank unless the deployment host receives
# EA 403 responses and you have an approved browser cookie or request relay.
EA_PROCLUBS_COOKIE=
EA_PROCLUBS_SEARCH_BASE_URL=

# One-time legacy VXN import inputs. These are only used by the beta migration
# command and are not required by the running website.
ATHEUS_VXN_DISCORD_GUILD_ID=
ATHEUS_VXN_OWNER_DISCORD_USER_ID=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# The DSN is also hardcoded as a fallback in the sentry.*.config.ts files, so
# Sentry works without these; set them to override per environment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (optional — build still succeeds without them).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Dev-bot alert forwarding: when both are set, captured server errors are POSTed
# to the atheus dev bot, which posts them into the staff #dev-alerts channel.
# Point ATHEUS_ALERT_URL at the dev bot's intake (e.g. https://bot-host:8787/alert)
# and use the same secret configured on the bot.
ATHEUS_ALERT_URL=
ATHEUS_ALERT_SECRET=
