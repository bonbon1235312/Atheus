# Atheus environment variables
# Copy to .env.local for development, set on Vercel for production.

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Address enquiries are sent FROM.
# Before atheus.dev is verified on Resend, use the test sender:
#   Atheus <onboarding@resend.dev>
# After the DNS records are verified, switch to your own domain:
#   Atheus <hello@atheus.dev>
CONTACT_FROM_EMAIL="Atheus <onboarding@resend.dev>"

# Address enquiries are delivered TO. Where you actually read mail.
CONTACT_TO_EMAIL=hello@atheus.dev

# ---------------------------------------------------------------------------
# Dashboard — Discord OAuth (Auth.js)
# Discord Developer Portal → your app → OAuth2.
# Add redirect URL: http://localhost:3000/api/auth/callback/discord (and prod).
# ---------------------------------------------------------------------------
AUTH_DISCORD_ID=your-discord-application-id
AUTH_DISCORD_SECRET=your-discord-client-secret
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=your-generated-secret
# Bot token (same bot as atheus-bot) — used to read a server's roles.
DISCORD_BOT_TOKEN=your-bot-token

# ---------------------------------------------------------------------------
# Supabase — SAME project as the bot. Service role key (server-side only).
# ---------------------------------------------------------------------------
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Stripe — Pro billing. Writes the `premium` table the bot reads.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx          # the recurring "atheus Pro" price
STRIPE_WEBHOOK_SECRET=whsec_xxx    # from the webhook endpoint you create
